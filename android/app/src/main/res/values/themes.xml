<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose: the app's dark, calm surface (Compose draws the rest). -->
    <style name="Theme.TabberSpak" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Tabber Studio's screen surface, Studio.bg1: no other colour shows while the app starts. -->
    <color name="surface">#FF1D1D2B</color>
</resources>
