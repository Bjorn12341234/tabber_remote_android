{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabber.studio/schemas/remote/1/topics/meters.json",
  "title": "Event data for the meters topic",
  "type": "object",
  "properties": {
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "track_id": {
            "$ref": "../common.json#/$defs/id"
          },
          "peak": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            },
            "description": "Linear peak per channel since the last meters event, 1.0 is 0 dBFS."
          }
        },
        "required": [
          "track_id",
          "peak"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "levels"
  ],
  "additionalProperties": false
}
