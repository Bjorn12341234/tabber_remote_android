          "$ref": "../common.json#/$defs/key"
        },
        "strip_id": {
          "$ref": "../common.json#/$defs/id"
        },
        "bus_id": {
          "$ref": "../common.json#/$defs/id"
        },
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pre_fader": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "strip_id",
        "bus_id"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "routing": {
          "$ref": "../common.json#/$defs/routing"
        },
        "undo": {
          "$ref": "../common.json#/$defs/undo"
        }
