{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabber.studio/schemas/remote/1/methods/routing.set_send.json",
  "title": "routing.set_send",
  "x-capability": "routing/1",
  "x-changes": true,
  "$defs": {
    "params": {
      "type": "object",
