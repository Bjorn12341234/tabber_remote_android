{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabber.studio/schemas/remote/1/methods/hello.json",
  "title": "hello",
  "x-capability": null,
  "x-changes": false,
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "app": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "../common.json#/$defs/name"
            },
            "version": {
              "type": "string",
              "maxLength": 32
            },
            "build": {
              "type": "string",
              "maxLength": 32
            },
            "platform": {
              "enum": [
                "ios",
                "android"
              ]
            }
          },
          "required": [
            "name",
            "version",
            "build",
            "platform"
          ],
          "additionalProperties": false
        },
        "protocol_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../common.json#/$defs/protocol_version"
          }
        }
      },
      "required": [
        "app",
        "protocol_versions"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "host": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "../common.json#/$defs/uuid"
            },
            "name": {
              "$ref": "../common.json#/$defs/name"
            },
            "app_version": {
              "type": "string",
              "maxLength": 32
            }
          },
          "required": [
            "id",
            "name",
            "app_version"
          ],
          "additionalProperties": false
        },
        "protocol_version": {
          "$ref": "../common.json#/$defs/protocol_version"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "../common.json#/$defs/capability"
          },
          "uniqueItems": true
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_frame_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "requests_per_second": {
              "type": "integer",
              "minimum": 1
            },
            "burst": {
              "type": "integer",
              "minimum": 1
            },
            "heartbeat_ms": {
              "type": "integer",
              "minimum": 1
            },
            "heartbeat_misses": {
              "type": "integer",
              "minimum": 1
            },
            "connections_per_device": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "max_frame_bytes",
            "requests_per_second",
            "burst",
            "heartbeat_ms",
            "heartbeat_misses",
            "connections_per_device"
          ],
          "additionalProperties": false
        },
        "challenge": {
          "$ref": "../common.json#/$defs/sha256_b64url"
        }
      },
      "required": [
        "host",
        "protocol_version",
        "capabilities",
        "limits",
        "challenge"
      ],
      "additionalProperties": false
    }
  }
}
