{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabber.studio/schemas/remote/1/methods/auth.json",
  "title": "auth",
  "x-capability": null,
  "x-changes": false,
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "../common.json#/$defs/sha256_b64url"
        },
        "signature": {
          "$ref": "../common.json#/$defs/b64url"
        }
      },
      "required": [
        "device_id",
        "signature"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "device": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "../common.json#/$defs/sha256_b64url"
            },
            "name": {
              "$ref": "../common.json#/$defs/name"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "device"
      ],
      "additionalProperties": false
    }
  }
}
