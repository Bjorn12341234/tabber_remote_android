{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabber.studio/schemas/remote/1/methods/transport.record.json",
  "title": "transport.record",
  "x-capability": "record/1",
  "x-changes": true,
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "../common.json#/$defs/key"
        },
        "armed_track_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.json#/$defs/id"
          }
        },
        "count_in_bars": {
          "enum": [
            0,
            1,
            2
          ]
        }
      },
      "required": [
        "key",
        "armed_track_ids"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "transport": {
          "$ref": "../common.json#/$defs/transport"
        },
        "record": {
          "$ref": "../common.json#/$defs/record"
        }
      },
      "required": [
        "transport",
        "record"
      ],
      "additionalProperties": false
    }
  }
}
