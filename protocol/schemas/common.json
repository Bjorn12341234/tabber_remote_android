{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabber.studio/schemas/remote/1/common.json",
  "title": "Shared definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "A random UUID, version 4, lowercase."
    },
    "key": {
      "$ref": "#/$defs/uuid",
      "description": "Idempotency key: one per user action, reused on resend (spec 5.1)."
    },
    "b64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 4096,
      "description": "base64url without padding."
    },
    "sha256_b64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "32 bytes (a SHA-256 or a challenge) as base64url without padding."
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "description": "16 bytes as base64url without padding."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "An opaque, stable id chosen by the host."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "host_time": {
      "type": "number",
      "minimum": 0,
      "description": "Seconds on the host's monotonic clock."
    },
    "bar_beat": {
      "type": "object",
      "properties": {
        "bar": {
          "type": "integer",
          "minimum": 1
        },
        "beat": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "bar",
        "beat"
      ],
      "additionalProperties": false,
      "description": "A place in the song, counted from bar 1 beat 1."
    },
    "position": {
      "type": "object",
      "properties": {
        "bar": {
          "type": "integer",
          "minimum": 1
        },
        "beat": {
          "type": "integer",
          "minimum": 1
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "bar",
        "beat",
        "seconds"
      ],
      "additionalProperties": false,
      "description": "Where the playhead is: bar and beat from 1, and seconds from the start."
    },
    "transport_state": {
      "enum": [
        "stopped",
        "playing",
        "paused"
      ]
    },
    "transport": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/transport_state"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "tempo_bpm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "tempo_scale": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 2.0
        },
        "time_signature": {
          "type": "object",
          "properties": {
            "beats": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "unit": {
              "enum": [
                1,
                2,
                4,
                8,
                16,
                32
              ]
            }
          },
          "required": [
            "beats",
            "unit"
          ],
          "additionalProperties": false
        },
        "loop": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "start": {
              "oneOf": [
                {
                  "$ref": "#/$defs/bar_beat"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end": {
              "oneOf": [
                {
                  "$ref": "#/$defs/bar_beat"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "enabled",
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "click": {
          "type": "boolean"
        },
        "count_in_bars": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "counting_in": {
          "type": "boolean"
        }
      },
      "required": [
        "state",
        "position",
        "tempo_bpm",
        "tempo_scale",
        "time_signature",
        "loop",
        "click",
        "count_in_bars",
        "counting_in"
      ],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "properties": {
        "recording": {
          "type": "boolean"
        },
        "started": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "position": {
                  "$ref": "#/$defs/position"
                },
                "t": {
                  "$ref": "#/$defs/host_time"
                }
              },
              "required": [
                "position",
                "t"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "armed_track_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "recording",
        "started",
        "armed_track_ids"
      ],
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "audio",
            "midi"
          ]
        },
        "armed": {
          "type": "boolean"
        },
        "monitor": {
          "enum": [
            "off",
            "auto",
            "on"
          ]
        },
        "selected": {
          "type": "boolean"
        },
        "color": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "instrument": {
          "type": "string",
          "maxLength": 200,
          "description": "What a tab or MIDI track plays (mixer/1, tab/1 hosts)."
        },
        "tuning": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "description": "A tab track's open strings as MIDI notes, highest first; absent when the track has no tab."
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "armed",
        "monitor",
        "selected",
        "color"
      ],
      "additionalProperties": false
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "marker": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "bar": {
          "type": "integer",
          "minimum": 1
        },
        "beat": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "name",
        "bar",
        "beat"
      ],
      "additionalProperties": false
    },
    "markers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/marker"
      }
    },
    "take": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "track_id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "start": {
          "$ref": "#/$defs/position"
        },
        "length_seconds": {
          "type": "number",
          "minimum": 0
        },
        "rating": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "active": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "track_id",
        "name",
        "start",
        "length_seconds",
        "rating",
        "active"
      ],
      "additionalProperties": false
    },
    "takes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/take"
      }
    },
    "recent_takes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/take"
      },
      "maxItems": 20,
      "description": "The newest takes on any track, newest first."
    },
    "undo_step": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "id",
            "label"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "undo": {
      "type": "object",
      "properties": {
        "undo": {
          "$ref": "#/$defs/undo_step"
        },
        "redo": {
          "$ref": "#/$defs/undo_step"
        }
      },
      "required": [
        "undo",
        "redo"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "unsaved": {
          "type": "boolean"
        },
        "has_file": {
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "unsaved",
        "has_file"
      ],
      "additionalProperties": false
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z_.]*/[0-9]+$"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "topic": {
      "enum": [
        "transport",
        "position",
        "record",
        "tracks",
        "markers",
        "takes",
        "undo",
        "project",
        "meters",
        "mixer",
        "mixer_meters",
        "tab",
        "routing",
        "chat",
        "view",
        "trainer"
      ]
    },
    "host": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "$ref": "#/$defs/name"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "empty": {
      "type": "object",
      "additionalProperties": false
    },
    "strip": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "track",
            "bus",
            "master"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "color": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "The fader's travel, in the host's own fader law."
        },
        "volume_db": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -200,
              "maximum": 24
            },
            {
              "type": "null"
            }
          ],
          "description": "What the fader means; null is silence."
        },
        "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "pan_label": {
          "type": "string",
          "maxLength": 8,
          "description": "As Tabber Studio writes it: L64, C, R63."
        },
        "muted": {
          "type": "boolean"
        },
        "soloed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "color",
        "volume",
        "volume_db",
        "pan",
        "pan_label",
        "muted",
        "soloed"
      ],
      "additionalProperties": false
    },
    "scale_mark": {
      "type": "object",
      "properties": {
        "db": {
          "type": "number",
          "minimum": -200,
          "maximum": 24
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "db",
        "volume"
      ],
      "additionalProperties": false
    },
    "mixer": {
      "type": "object",
      "properties": {
        "strips": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/strip"
          },
          "description": "Every track's strip in strip order, then the buses, then the master."
        },
        "scale": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/scale_mark"
          },
          "description": "The fader's marks, top down, for drawing its scale."
        }
      },
      "required": [
        "strips",
        "scale"
      ],
      "additionalProperties": false
    },
    "time_signature": {
      "type": "object",
      "properties": {
        "beats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "unit": {
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32
          ]
        }
      },
      "required": [
        "beats",
        "unit"
      ],
      "additionalProperties": false
    },
    "note_value": {
      "type": "object",
      "properties": {
        "value": {
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32
          ]
        },
        "dotted": {
          "type": "boolean"
        },
        "triplet": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "dotted",
        "triplet"
      ],
      "additionalProperties": false
    },
    "tab_note": {
      "type": "object",
      "properties": {
        "string": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "fret": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        }
      },
      "required": [
        "string",
        "fret"
      ],
      "additionalProperties": false
    },
    "tab_beat": {
      "type": "object",
      "properties": {
        "duration": {
          "$ref": "#/$defs/note_value"
        },
        "rest": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/tab_note"
          }
        }
      },
      "required": [
        "duration",
        "rest",
        "notes"
      ],
      "additionalProperties": false
    },
    "tab_bar": {
      "type": "object",
      "properties": {
        "bar": {
          "type": "integer",
          "minimum": 1
        },
        "time_signature": {
          "$ref": "#/$defs/time_signature"
        },
        "beats": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/tab_beat"
          }
        }
      },
      "required": [
        "bar",
        "time_signature",
        "beats"
      ],
      "additionalProperties": false
    },
    "tab_cursor": {
      "type": "object",
      "properties": {
        "bar": {
          "type": "integer",
          "minimum": 1
        },
        "beat": {
          "type": "integer",
          "minimum": 1
        },
        "string": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      },
      "required": [
        "bar",
        "beat",
        "string"
      ],
      "additionalProperties": false
    },
    "tab_state": {
      "type": "object",
      "properties": {
        "track_id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "tuning": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          }
        },
        "drum": {
          "type": "boolean"
        },
        "cursor": {
          "$ref": "#/$defs/tab_cursor"
        },
        "duration": {
          "$ref": "#/$defs/note_value"
        },
        "bar_count": {
          "type": "integer",
          "minimum": 1
        },
        "bars": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/tab_bar"
          },
          "description": "The cursor's bar and its neighbours: one before, three after."
        }
      },
      "required": [
        "track_id",
        "revision",
        "tuning",
        "drum",
        "cursor",
        "duration",
        "bar_count",
        "bars"
      ],
      "additionalProperties": false
    },
    "tab_or_none": {
      "oneOf": [
        {
          "$ref": "#/$defs/tab_state"
        },
        {
          "type": "null"
        }
      ],
      "description": "The selected track's tab, or null when the selected track has none."
    },
    "routing_source": {
      "type": "object",
      "properties": {
        "strip_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "track",
            "bus"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "output": {
          "$ref": "#/$defs/id",
          "description": "master, or the strip id of the bus it outputs to."
        }
      },
      "required": [
        "strip_id",
        "kind",
        "name",
        "output"
      ],
      "additionalProperties": false
    },
    "routing_send": {
      "type": "object",
      "properties": {
        "strip_id": {
          "$ref": "#/$defs/id",
          "description": "The track that sends."
        },
        "bus_id": {
          "$ref": "#/$defs/id",
          "description": "The strip id of the bus it sends to."
        },
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "The send's gain, as the host stores it."
        },
        "level_db": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -60,
              "maximum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "What the level means; null is silence."
        },
        "level_label": {
          "type": "string",
          "maxLength": 12,
          "description": "As Tabber Studio writes it: -6.0 dB."
        },
        "pre_fader": {
          "type": "boolean"
        }
      },
      "required": [
        "strip_id",
        "bus_id",
        "level",
        "level_db",
        "level_label",
        "pre_fader"
      ],
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/routing_source"
          },
          "description": "Every track in strip order, then every bus, each with its one output."
        },
        "sends": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/routing_send"
          },
          "description": "Every send, in strip order, then the mixer's bus order."
        }
      },
      "required": [
        "sources",
        "sends"
      ],
      "additionalProperties": false
    },
    "chat_message": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "enum": [
            "you",
            "studio"
          ]
        },
        "kind": {
          "enum": [
            "text",
            "result",
            "refusal",
            "error"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "id",
        "from",
        "kind",
        "text"
      ],
      "additionalProperties": false
    },
    "chat_plan": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "maxLength": 4000,
          "description": "What the AI means to do, in its words."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 400
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "text",
        "steps"
      ],
      "additionalProperties": false
    },
    "chat": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean",
          "description": "False when Tabber Studio has no AI set up."
        },
        "state": {
          "enum": [
            "idle",
            "thinking",
            "waiting",
            "running"
          ],
          "description": "thinking: working on an answer; waiting: a plan waits for Confirm; running: a confirmed plan runs."
        },
        "messages": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/chat_message"
          },
          "description": "The conversation, oldest first."
        },
        "plan": {
          "oneOf": [
            {
              "$ref": "#/$defs/chat_plan"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "available",
        "state",
        "messages",
        "plan"
      ],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "editor": {
          "enum": [
            "arrange",
            "tab",
            "piano_roll"
          ],
          "description": "The editor on screen; in Split, the one beside Arrange."
        },
        "split": {
          "type": "boolean"
        },
        "part": {
          "oneOf": [
            {
              "$ref": "#/$defs/view_part"
            },
            {
              "type": "null"
            }
          ],
          "description": "The chosen MIDI track as the Tab editor shows it (view.part/1); null when it shows none."
        }
      },
      "required": [
        "editor",
        "split"
      ],
      "additionalProperties": false
    },
    "trainer": {
      "type": "object",
      "description": "Tabber Studio's Speed Trainer. With Loop on, each time the loop comes round the speed goes up by step, from start until it reaches target.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "start": {
          "type": "integer",
          "minimum": 25,
          "maximum": 200,
          "description": "The speed the loop starts at, in percent."
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Added each time the loop comes round, in percent."
        },
        "target": {
          "type": "integer",
          "minimum": 25,
          "maximum": 200,
          "description": "The speed it stops at, in percent."
        },
        "speed": {
          "type": "integer",
          "minimum": 25,
          "maximum": 200,
          "description": "The speed now, in percent."
        }
      },
      "required": [
        "enabled",
        "start",
        "step",
        "target",
        "speed"
      ],
      "additionalProperties": false
    },
    "view_part": {
      "type": "object",
      "properties": {
        "track_id": {
          "$ref": "#/$defs/id"
        },
        "shows": {
          "enum": [
            "card",
            "midi_tab",
            "notation"
          ],
          "description": "The MIDI part card, MIDI tab or standard notation."
        },
        "midi_tab": {
          "type": "boolean",
          "description": "Whether the track can show MIDI tab: a melodic MIDI track."
        }
      },
      "required": [
        "track_id",
        "shows",
        "midi_tab"
      ],
      "additionalProperties": false
    }
  }
}
